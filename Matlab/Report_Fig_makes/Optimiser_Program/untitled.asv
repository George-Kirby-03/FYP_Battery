plot(sim_handler.states_sol.T,sim_handler.states_sol.Pol+sim_handler.ocv_curve(sim_handler.states_sol.SoC))
hold on
plot(sim_handler.original_data.ts,sim_handler.original_data.volts)
title('Team 1 Strikes')

% Team 2
nexttile
