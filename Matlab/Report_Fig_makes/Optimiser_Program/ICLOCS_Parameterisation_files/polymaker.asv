function poly = polymaker(polycount, range, predict_Q, temp, lower_bound)
%POLYMAKER Quick Function To Produce the Polynomial Coefficent & indexes
%NOTE: R0, R1, C, Q in that order AFTER
 arguments
        polycount = 0
        range = 0
        predict_Q = 0
        temp = 0  
        lower_bound = 0
 end

if polycount
poly.xl = -ones(1,polycount)*range;
poly.xe = rand(1,polycount);
poly.xu = ones(1,polycount)*range;
if lower_bound ~= 0
    poly.xl(1) = lower_bound - 0.05;
    poly.xe(1) = poly.xl(1);
    poly.xu(1) = poly.xe(1) + 0.05; 
end
poly.R0 = polycount+1;
poly.R1 = polycount+2;
poly.C  = polycount+3;
if predict_Q == 1 && temp == 1
    poly.Q = polycount+4;
    poly.Cp = polycount+5;
    poly.h = polycount+6;
elseif predict_Q == 0 && temp == 1
    poly.Cp = polycount+4;
    poly.h = polycount+5;
elseif predict_Q == 1 %Temp must be not getting predicted then
    poly.Q = polycount+4;
end %if not q or temp, neither added

end